<div title="${title}" 
    tags="build" 
    created="${created}" 
    modified="${modified}" 
    caption="${caption}" 
    desc="${desc}" 
    sort="${sort}" 
    affinity="${affinity}" 
    build="${build}" 
    build-name="${build-name}" 
    file-name="${file-name}" 
    kit="${kit-key}" 
    kit-number="${kit-number}" 
    manufacturer="${manufacturer}"
    scale="${scale}" 
>
