\define ImagePopup(build, file-path)

    <$button popup="$:/ebb:state:$build$.$file-path$" class="tc-btn-invisible tc-tiddlylink"><$image height="50" source={{!!file-path}} /></$button>

    <$reveal type="popup" state="$:/ebb:state:$build$.$file-path$" >
        <$image width="825" source={{!!file-path}} /> 
    </$reveal>

\end


\define Colors()

    <$list filter="[tag[task]field:build{!!build}field:step{!!step}has[color-index]each[color-index]] +[sort[color-index]]" >
        <$macrocall $name="Color" />
    </$list>

\end


\define Color()

    <$list filter="[tag[color]color-index{!!color-index}]" >
        {{!!brand}} #{{!!color-number}} ({{!!caption}})
        <$list filter="[tag[color]color-index{!!color-index}has[fs]]" > 
            {{!!fs}}
        </$list>
    </$list>

\end
