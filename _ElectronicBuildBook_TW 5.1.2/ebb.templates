\define CommentBlock()

<!-- 

    2026-09-09 001 CJG  - Update/simplify task filter in StepTemplateFooter().
                          Does not require the use of the Task:Tasks regex field.
                          
    2026-09-23 001 CJG  - Change pre-req tasks to regex so that sub-assemblies can have pre-reqs.
    
    2026-10-07 001 CJG  - Change task pre-reqs into comma delimited list.
    
    2026-10-10 001 CJG  - Make task pre-reqs links to appropriate step.
           
-->

\end


\define BuildTemplateHeader()
 
    ---
    !!{{!!caption}}

\end


\define BuildTemplateFooter()

    ---
    !!!''Box Contents:''

    <$list filter="[tag[image]field:build{!!build}!has[step]] +[sort[sort]]" >
        <$macrocall $name="ImagePopup" build={{!!build}}  file-path={{!!file-path}}  />
    </$list>

    ---
    !!!''Paint Callout:''

    <$list filter="[tag[task]field:build{!!build}has[color-index]each[color-index]] +[sort[color-index]]" >
        <$macrocall $name="Color" />
        <br/>
    </$list>

    ---
    !!!''Step Callout:''

    <$list filter="[tag[step]field:build{!!build}] +[nsort[step]]" >
        <$checkbox tag="done" />
        <$link>Step {{!!step}})</$link> &nbsp; {{!!desc}}
        <br/>
    </$list>
 
\end


\define StepTemplateHeader()
 
    <div style="float: left;" class="no-print" >
        <$list filter="[field:build{!!build}tag[step]step{!!prev-step}]" >
            <$link><< prev</$link>
        </$list>
    </div>

    <div style="float: right;" class="no-print" >
        <$list filter="[field:build{!!build}tag[step]step{!!next-step}]" >
            <$link>next >></$link>
        </$list>
     </div>

    <div style="clear: both;" />

    ---

    <$list filter="[all[current]field:step[1]]" >

        {{$:/ebb:TaskType:PrepareBuild.description}}

    </$list>


    !!Step {{!!step}}) {{!!desc}}
  
    <$macrocall $name="TaskType" task-type="{{!!task-type}}" task-type-format="description" />

\end


\define StepTemplateFooter()

    <div style="clear: both;" />

    <$list filter="[tag[image]field:build{!!build}field:step{!!step}] +[sort[sequence]]" >
        <$macrocall $name="ImagePopup" build={{!!build}}  file-path={{!!file-path}}  />
    </$list>

  
    <$list filter="[tag[task]field:build{!!build}field:step{!!step}has[part-callout]last[]]" >

        ---
    </$list>
 
    !!!<$macrocall $name="TaskType" task-type="{{!!task-type}}"  task-type-format="summary" />

    <$set name="step" value={{!!step}} >

        <$list filter="[tag[build]field:build{!!build}]" >
            <$set name="kit" value={{!!kit}} >

                <$list filter="[tag[step]field:build{!!build}field:step<step>]" >

                    <$list filter="[tag[task]field:build{!!build}field:step{!!step}has[task-type]] +[sort[title]]" >
                        <$macrocall $name="TaskTemplate" />
                    </$list>
                </$list>
            </$set>
        </$list>
    </$set>

    <$list filter="[tag[task]field:build{!!build}field:step{!!step}has[color-index]first[]]" >

    ---
    !!!Paint Callout:

        <$list filter="[tag[task]field:build{!!build}field:step{!!step}has[color-index]each[color-index]] +[sort[color-index]]" >
            <$macrocall $name="Color" />
            <br/>
        </$list>
    </$list>

    ---
    !!!Tool(s)
    <ul>
        <$list filter="[tag[tool]regexp:tool{!!tools}] +[sort[caption]]" ><li>{{!!caption}}</li></$list>
    </ul>

    <div style="float: left;" class="no-print" >
        <$list filter="[field:build{!!build}tag[step]step{!!prev-step}]" >
            <$link><< prev</$link>
        </$list>
    </div>

    <div style="float: right;" class="no-print" >
        <$list filter="[field:build{!!build}tag[step]step{!!next-step}]" >
            <$link>next >></$link>
        </$list>
    </div>

\end


\define TaskPreRequisite()

    <$list filter="[tag[task]field:build{!!build}regexp:task{!!prereq-task}!tag[done]sort[sort]first[]]">&nbsp; `Pre-Req Task(s)` (</$list>
    <$list filter="[tag[task]field:build{!!build}regexp:task{!!prereq-task}!tag[done]sort[sort]butlast[]]">
        <$set name="xtask" value={{!!task}}>
            <$list filter="[tag[step]field:build{!!build}field:step{!!step}]" ><$link to=<<currentTiddler>> ><<xtask>></$link>, </$list>
        </$set>
    </$list>
    <$list filter="[tag[task]field:build{!!build}regexp:task{!!prereq-task}!tag[done]sort[sort]last[]]">
        <$set name="xtask" value={{!!task}}>
            <$list filter="[tag[step]field:build{!!build}field:step{!!step}]" ><$link to=<<currentTiddler>> ><<xtask>></$link></$list>
        </$set>)
    </$list>

\end


\define TaskTemplate()

    <$checkbox tag="done" >
        Task {{!!task}}) &nbsp; {{!!part-callout}}

        <$list filter="[tag[part]field:part-callout{!!part-callout}field:kit<kit>]" > - {{!!desc}}</$list>

        ''//{{!!desc}}//''<$list filter="[tag[task]field:build{!!build}field:task{!!task}has[prereq-task]]" ><$macrocall $name="TaskPreRequisite" /></$list> 
    </$checkbox>
    <br/>

\end



\define TaskType(task-type, task-type-format)

    <$macrocall $name=$task-type$ format=$task-type-format$   />

\end



\define Airbrush(format)

    <$reveal state="$:/ebb:TaskType.format.description" text="$format$" type="match" >

        {{$:/ebb:TaskType:Airbrush.description}}

    </$reveal>

    <$reveal state="$:/ebb:TaskType.format.summary" text="$format$" type="match" >
        Airbrush part(s) using //<$macrocall $name="Colors"  />//
    </$reveal>
  
\end


\define ApplyDecal(format)

    <$reveal state="$:/ebb:TaskType.format.description" text="$format$" type="match" >

        {{$:/ebb:TaskType:ApplyDecal.description}}

    </$reveal>

    <$reveal state="$:/ebb:TaskType.format.summary" text="$format$" type="match" >
        Apply decal(s)
    </$reveal>
  
\end


\define ApplyPrimer(format)

    <$reveal state="$:/ebb:TaskType.format.description" text="$format$" type="match" >

